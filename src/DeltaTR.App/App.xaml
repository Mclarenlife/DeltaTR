<Application x:Class="DeltaTR.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Shell.xaml"/><ResourceDictionary Source="Themes/Inputs.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Panel" Color="#141C29"/>
        <SolidColorBrush x:Key="Muted" Color="#A4B1C3"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EFF7"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E9EFF7"/><Setter Property="Background" Value="#27364B"/>
            <Setter Property="BorderBrush" Value="#42536B"/><Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E9EFF7"/><Setter Property="Background" Value="#0D1420"/>
            <Setter Property="BorderBrush" Value="#42536B"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1C2839"/><Setter Property="Foreground" Value="#A4B1C3"/>
            <Setter Property="Padding" Value="12,9"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,7"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
