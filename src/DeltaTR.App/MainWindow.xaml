<Window x:Class="DeltaTR.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:DeltaTR.App.Views"
        Title="DeltaTR · 车队工作空间" Width="1380" Height="900" MinWidth="1080" MinHeight="720" Background="#10161F" Foreground="#E7EDF5"
        FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Template><ControlTemplate TargetType="Window"><Border Background="{TemplateBinding Background}"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border></ControlTemplate></Window.Template>
    <Window.Resources>
        <DataTemplate x:Key="OverviewPage"><views:OverviewView/></DataTemplate>
        <DataTemplate x:Key="RadioPage"><views:RadioView/></DataTemplate>
        <DataTemplate x:Key="OverlayPage"><views:OverlayView/></DataTemplate>
        <DataTemplate x:Key="VocabularyPage"><views:VocabularyView/></DataTemplate>
        <DataTemplate x:Key="AutomationPage"><views:AutomationView/></DataTemplate>
        <DataTemplate x:Key="StrategyPage"><views:StrategyView/></DataTemplate>
        <DataTemplate x:Key="SettingsPage"><views:SettingsView/></DataTemplate>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="#2A3542" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0D121A" BorderBrush="#26303D" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Border Width="25" Height="25" Background="#9AE6BD" CornerRadius="5" Margin="0,0,10,0"><TextBlock Text="Δ" Foreground="#123125" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DeltaTR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0"><TextBlock Text="工作空间" Foreground="#748397"/><TextBlock Text=" / " Foreground="#48566A" Margin="9,0"/><TextBlock Text="{Binding SelectedPage.Title}" Foreground="#BBC7D5"/></StackPanel>
                    <Border Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Column="2" VerticalAlignment="Center" Background="#1A2927" CornerRadius="4" Padding="9,4" Margin="10,0,24,0"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#9AE6BD" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding SourceLabel}" ToolTip="{Binding SourceDescription}" Foreground="#A7D6BD" FontSize="11"/></StackPanel></Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M0,5 H10" Stroke="#BAC5D2" StrokeThickness="1" Width="10" Height="10"/></Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="ToggleMaximize" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE922;"/></Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="#BAC5D2" StrokeThickness="1" Width="10" Height="10"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#0E141D" BorderBrush="#26303D" BorderThickness="0,0,1,0">
                    <Grid Margin="14,28,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="8,0,8,18">
                            <TextBlock Text="选择游戏" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                            <ComboBox x:Name="GamePicker" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelectGame}" Padding="8,6" AutomationProperties.Name="选择游戏">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InputText}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <ListBox Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" x:Name="NavigationList" Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavigationItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="主导航">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Border Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Row="3" Background="#151F2A" BorderBrush="#263443" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,24,0,16"><StackPanel><TextBlock Text="离线也能开始" FontWeight="SemiBold"/><TextBlock Text="使用当前游戏的演示数据练习问答。" Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,12"/><Button Content="启动演示  →" Command="{Binding DemoCommand}" Style="{StaticResource Action}" Padding="10,8"/></StackPanel></Border>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="12,0"><TextBlock Text="LOCAL FIRST" Foreground="#63768A" FontSize="10"/><TextBlock Text="v0.13.4" Foreground="#63768A" FontSize="10" Margin="26,0,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Visibility="{Binding ShowGamePrompt, Converter={StaticResource BoolVisibility}}" Text="请先在左侧选择游戏" FontSize="24" Foreground="#BBC7D5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid x:Name="GameWorkspace" Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Column="1" Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedPage.Title}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPage.Description}" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding ConnectLabel}" ToolTip="{Binding SourceDescription}" Style="{StaticResource Action}" Command="{Binding LiveCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                    <ContentControl Grid.Row="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource RadioPage}"/><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="overview"><Setter Property="ContentTemplate" Value="{StaticResource OverviewPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="overlay"><Setter Property="ContentTemplate" Value="{StaticResource OverlayPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="vocabulary"><Setter Property="ContentTemplate" Value="{StaticResource VocabularyPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="automation"><Setter Property="ContentTemplate" Value="{StaticResource AutomationPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="strategy"><Setter Property="ContentTemplate" Value="{StaticResource StrategyPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger>
                    </Style.Triggers></Style></ContentControl.Style></ContentControl>
                </Grid>
            </Grid>
            <Border Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Row="2" BorderBrush="#26303D" BorderThickness="0,1,0,0" Background="#0D121A" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="#8B9BAE" Width="5" Height="5" Margin="0,0,8,0"/><TextBlock Text="{Binding VoiceStatus}" FontSize="10" Foreground="#8F9EAF"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Notice}" ToolTip="{Binding Notice}" TextTrimming="CharacterEllipsis" Margin="24,0" FontSize="10" Foreground="#748397" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="本地语音 · TEAM RADIO" FontSize="10" Foreground="#748397" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
    </Border>
</Window>
