<Window x:Class="DeltaTR.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:DeltaTR.App.Views"
        Title="DeltaTR · 车队工作空间" Width="1380" Height="900" MinWidth="1080" MinHeight="720" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" WindowStyle="SingleBorderWindow">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Template><ControlTemplate TargetType="Window"><Border Background="{TemplateBinding Background}"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border></ControlTemplate></Window.Template>
    <Window.Resources>
        <DataTemplate x:Key="OverviewPage"><views:OverviewView/></DataTemplate>
        <DataTemplate x:Key="RadioPage"><views:RadioView/></DataTemplate>
        <DataTemplate x:Key="OverlayPage"><views:OverlayView/></DataTemplate>
        <DataTemplate x:Key="VocabularyPage"><views:VocabularyView/></DataTemplate>
        <DataTemplate x:Key="AutomationPage"><views:AutomationView/></DataTemplate>
        <DataTemplate x:Key="StrategyPage"><views:StrategyView/></DataTemplate>
        <DataTemplate x:Key="SettingsPage"><views:SettingsView/></DataTemplate>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource Rule}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="Δ" FontFamily="Segoe UI" Foreground="{DynamicResource Accent}" FontSize="24" Margin="0,0,8,1"/>
                        <TextBlock Text="DeltaTR" FontFamily="Segoe UI" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0"
                                Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="{Binding GameName}" FontWeight="SemiBold"/>
                        <Border Width="1" Height="14" Background="{DynamicResource Rule}" Margin="12,0"/>
                        <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource Secondary}" ToolTip="{Binding SourceDescription}"/>
                    </StackPanel>
                    <Button x:Name="ThemeButton" Grid.Column="2" Content="{Binding ThemeSwitchLabel}" Click="SwitchTheme"
                            AutomationProperties.Name="{Binding ThemeSwitchLabel}" ToolTip="切换深色与浅色外观"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Action}"
                            VerticalAlignment="Center" Padding="12,4" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M0,5 H10" Stroke="{DynamicResource Secondary}" StrokeThickness="1" Width="10" Height="10"/></Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="ToggleMaximize" ToolTip="最大化" AutomationProperties.Name="最大化或还原"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE922;"/></Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="关闭" AutomationProperties.Name="关闭"><Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{DynamicResource Secondary}" StrokeThickness="1" Width="10" Height="10"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,28,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="8,0,8,18">
                            <TextBlock Text="选择游戏" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                            <ComboBox x:Name="GamePicker" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                      IsEnabled="{Binding CanSelectGame}" Padding="8,6" AutomationProperties.Name="选择游戏">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <ListBox Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" x:Name="NavigationList" Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedPage}" ItemContainerStyle="{StaticResource NavigationItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="主导航">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="29" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/><TextBlock Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="3" Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Content="启动演示"
                                ToolTip="使用当前游戏的演示数据练习无线电问答" Command="{Binding DemoCommand}"
                                Style="{StaticResource Action}" HorizontalAlignment="Left" Padding="12,7" Margin="8,16,0,12"/>
                        <TextBlock Grid.Row="4" Text="DeltaTR  0.15.0" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="8,0"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowGamePrompt, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanSelectGame}">
                    <TextBlock Text="选择驾驶模拟器" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="进入对应游戏的无线电和遥测工作区" Style="{StaticResource Hint}" Margin="0,8,0,24"/>
                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Content="{Binding Name}" Click="ChooseSimulator" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding Name}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Action}">
                                    <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="16,12"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Id}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Grid x:Name="GameWorkspace" Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Column="1" Margin="28,24,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedPage.Title}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedPage.Description}" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding ConnectLabel}" ToolTip="{Binding SourceDescription}" Style="{StaticResource Action}" Command="{Binding LiveCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                    <ContentControl Grid.Row="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource RadioPage}"/><Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="overview"><Setter Property="ContentTemplate" Value="{StaticResource OverviewPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="overlay"><Setter Property="ContentTemplate" Value="{StaticResource OverlayPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="vocabulary"><Setter Property="ContentTemplate" Value="{StaticResource VocabularyPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="automation"><Setter Property="ContentTemplate" Value="{StaticResource AutomationPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="strategy"><Setter Property="ContentTemplate" Value="{StaticResource StrategyPage}"/></DataTrigger>
                        <DataTrigger Binding="{Binding SelectedPage.Key}" Value="settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger>
                    </Style.Triggers></Style></ContentControl.Style></ContentControl>
                </Grid>
            </Grid>
            <Border Visibility="{Binding HasGame, Converter={StaticResource BoolVisibility}}" Grid.Row="2" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Background="{DynamicResource Rail}" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource Subtle}" Width="5" Height="5" Margin="0,0,8,0"/><TextBlock Text="{Binding VoiceStatus}" FontSize="11" Foreground="{DynamicResource Subtle}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Notice}" ToolTip="{Binding Notice}" TextTrimming="CharacterEllipsis" Margin="24,0" FontSize="11" Foreground="{DynamicResource Subtle}" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
    </Border>
</Window>
