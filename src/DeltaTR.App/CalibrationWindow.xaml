<Window x:Class="DeltaTR.App.CalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeltaTR · HUD 校准向导" Width="1040" Height="800" MinWidth="960" MinHeight="740" Background="#0B111B" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="HUD 校准向导" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="用于练习时核验特定字段。日常查询排名、圈数和车速可直接使用内置读取规则。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="#142B29" Padding="14" CornerRadius="6" Margin="0,16,0,14"><StackPanel><TextBlock Text="{Binding Context}" Foreground="#62E1BA"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="1. 冻结当前遥测" Command="{Binding CaptureCommand}"/><TextBlock Grid.Column="1" Text="冻结时请记下对应 HUD 数值。后续数据更新不会改变这份样本。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></Grid>
        <Border Grid.Row="3" Background="#141C29" CornerRadius="6" Padding="16" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"><TextBlock Text="2. 选择字段并核对" Margin="0,0,0,10"/><ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding SelectedMetric}" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Key}" Foreground="{DynamicResource InputText}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding RawValue}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="23"/><TextBlock Text="{Binding Tolerance}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="HUD 读数 / 已确认单位" Margin="0,0,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox Text="{Binding HudValue, UpdateSourceTrigger=PropertyChanged}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" Margin="8,0,0,0" Padding="8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource InputText}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid><TextBlock Text="场景备注（例如：静止、热胎、进站补油后）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,6"/><TextBox Text="{Binding SampleNote, UpdateSourceTrigger=PropertyChanged}"/><Button Content="3. 加入人工对照" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding Progress}" Foreground="#62E1BA" Margin="0,0,0,8"/><DataGrid Grid.Row="1" ItemsSource="{Binding Comparisons}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#141C29" Foreground="#E9EFF7" RowBackground="#141C29" BorderThickness="0" GridLinesVisibility="None"><DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding Metric}" Width="1.3*"/><DataGridTextColumn Header="原始值" Binding="{Binding RawValue, StringFormat=0.###}" Width="*"/><DataGridTextColumn Header="HUD" Binding="{Binding HudValue}" Width="*"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="0.7*"/><DataGridTextColumn Header="场景" Binding="{Binding Note}" Width="2*"/></DataGrid.Columns></DataGrid></Grid>
        <StackPanel Grid.Row="5" Margin="0,16,0,0"><TextBlock Text="本次实验说明（操作者、比对方式、可选截图/录像路径）" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox Text="{Binding ExperimentNote, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <Grid Grid.Row="6" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="保存配置及核对证据，作为内置读取规则的补充。&#10;关闭窗口会放弃尚未保存的草稿。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="4. 保存校准包并加载" Command="{Binding SaveCommand}" Background="#204C40"/></Grid>
    </Grid>
</Window>
