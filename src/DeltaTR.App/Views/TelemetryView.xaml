<UserControl x:Class="DeltaTR.App.Views.TelemetryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="字段检查器" Style="{StaticResource SectionTitle}"/><TextBlock Text="悬停查看来源与观测时间；待核验值不用于可靠回答。" Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,0"/></StackPanel>
            <Grid Grid.Column="1" Width="260" VerticalAlignment="Center" Margin="16,0,0,0"><TextBox Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="按字段名称或质量状态筛选" AutomationProperties.Name="搜索遥测字段"/><TextBlock Text="搜索字段或质量状态…" IsHitTestVisible="False" Margin="13,0" VerticalAlignment="Center" Foreground="#75879B"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FieldFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"><Grid><DataGrid x:Name="TelemetryTable" ItemsSource="{Binding FilteredRows}" Style="{StaticResource FieldTable}" SelectionMode="Single"><DataGrid.Columns>
            <DataGridTextColumn Header="遥测字段" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="*"/><DataGridTextColumn Header="数据质量" Binding="{Binding Quality}" Width="1.5*"/>
        </DataGrid.Columns></DataGrid><TextBlock Text="{Binding EmptyFieldMessage}" Foreground="#8F9EAF" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FilteredRows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border>
        <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="{Binding FrameInfo}" Style="{StaticResource Eyebrow}" Margin="0,5,0,0" Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolVisibility}}"/></StackPanel>
    </Grid>
</UserControl>
