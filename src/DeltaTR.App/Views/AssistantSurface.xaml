<UserControl x:Class="DeltaTR.App.Views.AssistantSurface" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DeltaTR.App.Views" Focusable="False">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <Grid x:Name="Layers" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <views:IceCrystal x:Name="Avatar" Width="{Binding AvatarSide}" Height="{Binding AvatarSide}" Listening="{Binding IsListening}" Level="{Binding AudioLevel}" Opacity="{Binding AvatarAlpha}"/>
        <Grid x:Name="Bubble" Visibility="{Binding BubbleVisible, Converter={StaticResource VisibleWhenTrue}}" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding BubbleScale}" ScaleY="{Binding BubbleScale}"/></Grid.LayoutTransform>
            <Grid x:Name="Backdrop" Opacity="{Binding BackdropAlpha}">
                <Border Background="#172538" BorderBrush="#415971" BorderThickness="1" CornerRadius="16"/>
                <Polygon x:Name="Tail" Points="0,5 9,0 9,10" Width="9" Height="10" Fill="#172538" RenderTransformOrigin="0.5,0.5"/>
            </Grid>
            <StackPanel x:Name="Transcript" Margin="16,10" MaxWidth="244" Opacity="{Binding TextAlpha}">
                <TextBlock Text="{Binding OverlayStatus}" Foreground="#A4BEE2" FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers>
                        <DataTrigger Binding="{Binding OverlayStatus}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="108"><TextBlock x:Name="Message" Text="{Binding BubbleText}" TextWrapping="Wrap" Foreground="#F3F7FF" FontSize="15" LineHeight="22"/></ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
