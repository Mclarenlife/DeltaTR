<UserControl x:Class="DeltaTR.App.Views.AutomationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="Choice"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InputText}"/></DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,18,0"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding GameName, StringFormat={}{0} 的自动化}" Style="{StaticResource SectionTitle}"/>
            <Button x:Name="NewRuleButton" Grid.Row="1" Content="新建自动化" Command="{Binding NewAutomationCommand}" Style="{StaticResource Action}" Margin="0,14,0,14"/>
            <ListBox x:Name="RuleList" Grid.Row="2" ItemsSource="{Binding Automations}" SelectedItem="{Binding SelectedAutomation}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,9">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="从常用流程开始" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/>
                <Button x:Name="StartTemplateButton" Content="比赛开始 → 播报排名" Command="{Binding RaceStartTemplateCommand}" Style="{StaticResource Action}" Margin="0,0,0,8"/>
                <Button x:Name="IntervalTemplateButton" Content="每两分钟 → 排名和秒差" Command="{Binding IntervalTemplateCommand}" Style="{StaticResource Action}"/>
            </StackPanel>
        </Grid></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="自动化名称" Style="{StaticResource Eyebrow}"/>
            <TextBox x:Name="RuleName" Text="{Binding AutomationName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" AutomationProperties.Name="自动化名称"/>
            <CheckBox Content="启用这条自动化" IsChecked="{Binding AutomationEnabled}" Style="{StaticResource PreferenceCheck}"/>
            <TextBlock Text="当" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <ComboBox x:Name="TriggerSelector" ItemsSource="{Binding AutomationTriggers}" SelectedItem="{Binding AutomationTrigger}" ItemTemplate="{StaticResource Choice}" Padding="8" AutomationProperties.Name="触发条件"/>
            <StackPanel Visibility="{Binding AutomationUsesInterval, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
                <WrapPanel><TextBlock Text="每隔" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="IntervalSeconds" Text="{Binding AutomationInterval, UpdateSourceTrigger=PropertyChanged}" Width="90" AutomationProperties.Name="间隔秒数"/>
                    <TextBlock Text="秒（120 秒 = 2 分钟）" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#A4B1C3"/>
                </WrapPanel>
                <TextBlock Text="按有效驾驶时间计时，暂停和断线期间停止累计。" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
            </StackPanel>
            <TextBlock Text="依次执行" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <ListBox x:Name="ActionList" ItemsSource="{Binding ActionSequence}" SelectedItem="{Binding SelectedAction}" Height="154" Background="#101923" BorderBrush="#304153">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="8,7"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel Margin="0,10,0,10">
                <Button Content="上移" Command="{Binding MoveAutomationActionUpCommand}" Style="{StaticResource Action}" Padding="12,6"/>
                <Button Content="下移" Command="{Binding MoveAutomationActionDownCommand}" Style="{StaticResource Action}" Padding="12,6"/>
                <Button Content="移除动作" Command="{Binding RemoveAutomationActionCommand}" Style="{StaticResource Action}" Padding="12,6"/>
            </WrapPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding AutomationActions}" SelectedItem="{Binding ActionToAdd}" ItemTemplate="{StaticResource Choice}" Padding="8" AutomationProperties.Name="选择播报动作"/>
                <Button Grid.Column="1" Content="添加动作" Command="{Binding AddAutomationActionCommand}" Style="{StaticResource Action}" Margin="10,0,0,0"/>
            </Grid>
            <WrapPanel Margin="0,22,0,12">
                <Button x:Name="SaveRuleButton" Content="保存自动化" Command="{Binding SaveAutomationCommand}" Style="{StaticResource PrimaryAction}"/>
                <Button Content="预览播报文字" Command="{Binding PreviewAutomationCommand}" Style="{StaticResource Action}"/>
                <Button Content="删除" Command="{Binding DeleteAutomationCommand}" Style="{StaticResource Action}"/>
            </WrapPanel>
            <TextBlock Text="{Binding AutomationStatus}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" LineHeight="23"/>
        </StackPanel></ScrollViewer></Border>
    </Grid>
</UserControl>
