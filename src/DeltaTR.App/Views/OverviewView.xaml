<UserControl x:Class="DeltaTR.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="当前赛道" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Track}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8"/>
                        <TextBlock Text="{Binding Car}" Foreground="{DynamicResource Secondary}" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前数据源" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SourceLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,6"/><TextBlock Text="{Binding SourceDescription}" Style="{StaticResource Hint}" FontSize="11"/><Button Content="断开连接" Style="{StaticResource Action}" Command="{Binding StopCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,14,0,0"/></StackPanel></Border>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="0,16" Margin="0,16">
                <UniformGrid Columns="3">
                    <StackPanel Margin="24,0"><TextBlock Text="当前车速" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Speed}" Style="{StaticResource TimingFigure}"/><TextBlock Text="{Binding SpeedQuality}" Style="{StaticResource Eyebrow}"/></StackPanel>
                    <Border BorderBrush="{DynamicResource Rule}" BorderThickness="1,0" Padding="24,0"><StackPanel>
                        <TextBlock Text="剩余燃油" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Fuel}" Style="{StaticResource TimingFigure}"/>
                        <TextBlock Text="{Binding FuelQuality}" Style="{StaticResource Eyebrow}"/></StackPanel></Border>
                    <StackPanel Margin="24,0"><TextBlock Text="当前排名" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding Position}" Style="{StaticResource TimingFigure}" Foreground="{DynamicResource Accent}"/></StackPanel>
                </UniformGrid>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="轮胎状态" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding WheelDescription}" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,16"/>
                    <ItemsControl ItemsSource="{Binding Wheels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Inset}" CornerRadius="6" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Accent}" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text="{Binding Values}" Margin="0,9,0,6" FontFamily="Segoe UI" FontSize="14"/><TextBlock Text="{Binding NativeValues}" Foreground="{DynamicResource Secondary}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Quality}" Foreground="{DynamicResource Subtle}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,2,10,0"/><TextBlock Text="赛况简报" Style="{StaticResource SectionTitle}"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding TalkHint}" Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,14"/><TextBlock Grid.Row="2" Text="{Binding RaceBrief}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,14"/>
                    <Button Grid.Row="3" Content="打开无线电" Command="{Binding OpenRadioCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"/>
                </Grid></Border>
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" FontSize="11" Margin="2,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
