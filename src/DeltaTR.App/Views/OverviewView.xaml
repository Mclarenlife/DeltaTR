<UserControl x:Class="DeltaTR.App.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Background="#1B2E2A" BorderBrush="#315044" Margin="0,0,16,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SESSION OVERVIEW" Foreground="#A0C4B2" FontSize="10"/><TextBlock Text="准备好，下一圈。" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,14"/><TextBlock Text="{Binding Car}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track}" Foreground="#94B4A4" Margin="0,5,0,0"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="Δ" FontSize="105" FontWeight="Light" Foreground="#35594B" VerticalAlignment="Center" Margin="20,0,4,0"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前数据源" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding SourceLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,6"/><TextBlock Text="{Binding SourceDescription}" Style="{StaticResource Hint}" FontSize="11"/><Button Content="断开连接" Style="{StaticResource Action}" Command="{Binding StopCommand}" HorizontalAlignment="Left" Padding="12,7" Margin="0,14,0,0"/></StackPanel></Border>
            </Grid>
            <UniformGrid Columns="3" Margin="0,16,0,22">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel><TextBlock Text="当前车速" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Speed}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="{Binding SpeedQuality}" Style="{StaticResource Eyebrow}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16"><StackPanel><TextBlock Text="剩余燃油" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Fuel}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="{Binding FuelQuality}" Style="{StaticResource Eyebrow}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="当前排名" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Position}" FontFamily="Segoe UI" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,7,0,5"/><TextBlock Text="当前驾驶位置" Style="{StaticResource Eyebrow}"/></StackPanel></Border>
            </UniformGrid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0"><StackPanel><TextBlock Text="轮胎状态" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding WheelDescription}" Style="{StaticResource Hint}" FontSize="11" Margin="0,6,0,16"/>
                    <ItemsControl ItemsSource="{Binding Wheels}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#111A24" CornerRadius="6" Padding="14" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text="{Binding Values}" Margin="0,9,0,6" FontFamily="Segoe UI" FontSize="14"/><TextBlock Text="{Binding NativeValues}" Foreground="#A9BACE" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Quality}" Foreground="#76899E" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" Margin="0,2,10,0"/><TextBlock Text="赛况简报" Style="{StaticResource SectionTitle}"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding TalkHint}" Style="{StaticResource Hint}" FontSize="11" Margin="0,7,0,14"/><TextBlock Grid.Row="2" Text="{Binding RaceBrief}" TextWrapping="Wrap" LineHeight="23" Margin="0,0,0,14"/>
                    <Button Grid.Row="3" Content="打开无线电  →" Command="{Binding OpenRadioCommand}" Style="{StaticResource Action}" HorizontalAlignment="Left"/>
                </Grid></Border>
            </Grid>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" FontSize="11" Margin="2,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
