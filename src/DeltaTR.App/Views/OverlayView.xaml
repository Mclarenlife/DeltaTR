<UserControl x:Class="DeltaTR.App.Views.OverlayView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:DeltaTR.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
            <DockPanel><Button DockPanel.Dock="Right" Content="{Binding WheelButtonText}" Command="{Binding ToggleWheelScreenCommand}" Style="{StaticResource PrimaryAction}"/>
                <TextBlock Text="KS Pro 方向盘屏幕 · 实验功能" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="居中对称声波、实时输入文字与中文回答，适配 KS Pro 横向屏幕。" TextWrapping="Wrap" Margin="0,10,0,12"/>
            <ComboBox ItemsSource="{Binding WheelConnectionModes}" DisplayMemberPath="Label" SelectedValuePath="Bridge" SelectedValue="{Binding UsePitHouseBridge}" IsEnabled="{Binding CanChangeWheelMode}" Margin="0,0,0,12" AutomationProperties.Name="方向盘连接方式"/>
            <StackPanel Visibility="{Binding UsePitHouseBridge, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
                <CheckBox Content="智能仪表切换：短按讲话键切换画面，长按讲话" IsChecked="{Binding WheelSmartSwitch}" Margin="0,0,0,10"/>
                <CheckBox Content="赛事提醒和自动化播报临时弹出，结束后返回原仪表" IsChecked="{Binding WheelAutoPopup}" IsEnabled="{Binding WheelSmartSwitch}" Margin="0,0,0,10"/>
                <TextBlock Text="共用设置中的讲话键（键盘或方向盘按钮）。首次使用请先在 Pit House 选好比赛仪表；手动打开的 DeltaTR 画面会保持，直到再次短按。" TextWrapping="Wrap" Opacity="0.65" Margin="0,0,0,12"/>
                <DockPanel><Button DockPanel.Dock="Right" Content="选择 Pit House" Command="{Binding ChoosePitHouseCommand}" Margin="10,0,0,0"/><TextBox Text="{Binding PitHousePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pit House 程序路径"/></DockPanel>
                <WrapPanel Margin="0,8,0,0"><Button Content="安装 / 升级桥接" Command="{Binding InstallPitHouseBridgeCommand}" Margin="0,0,10,0"/><Button Content="恢复 Pit House 原文件" Command="{Binding RestorePitHouseBridgeCommand}"/></WrapPanel>
                <TextBlock Text="适用已验证的 Pit House 1.4.2.3。安装前备份并校验，更新后需重新适配。" TextWrapping="Wrap" Opacity="0.65" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Content="打开仪表文件夹" Command="{Binding OpenWheelDashboardCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding UsePitHouseBridge}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                <Button DockPanel.Dock="Right" Content="刷新设备" Command="{Binding RefreshWheelPortsCommand}" Margin="10,0,0,0"/>
                <ComboBox ItemsSource="{Binding WheelPorts}" SelectedItem="{Binding SelectedWheelPort}" DisplayMemberPath="Name" MinWidth="180" AutomationProperties.Name="方向盘显示设备"/></DockPanel>
            <TextBlock Text="{Binding WheelConnectionHelp}" TextWrapping="Wrap" Margin="0,12,0,8" Opacity="0.7"/>
            <TextBlock Text="{Binding WheelStatus}" TextWrapping="Wrap"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="{Binding OverlayButtonText}" Command="{Binding ToggleOverlayCommand}" Style="{StaticResource PrimaryAction}"/>
                <TextBlock Text="屏显预览" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border CornerRadius="8" Padding="12" Height="244">
                <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing><DrawingGroup>
                        <GeometryDrawing Brush="#263249" Geometry="M0,0 H24 V24 H0 Z"/>
                        <GeometryDrawing Brush="#2A3850" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z"/>
                    </DrawingGroup></DrawingBrush.Drawing>
                </DrawingBrush></Border.Background>
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><views:AssistantSurface x:Name="Preview" Placement="{Binding TextPlacement}"/></Viewbox>
            </Border>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
            <TextBlock Text="文字位置" Style="{StaticResource SectionTitle}"/>
            <ListBox ItemsSource="{Binding Placements}" SelectedValuePath="Key" SelectedValue="{Binding TextPlacement, Mode=TwoWay}" Margin="0,10,0,16"
                     Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" HorizontalAlignment="Center"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="大小" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="2" Margin="0,10,0,16">
                <StackPanel Margin="0,0,14,0"><DockPanel><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding AvatarSizePercent, StringFormat={}{0}%}"/><TextBlock Text="形象"/></DockPanel>
                    <Slider x:Name="AvatarSizeSlider" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding AvatarSizePercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="形象大小"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0"><DockPanel><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding BubbleSizePercent, StringFormat={}{0}%}"/><TextBlock Text="文字气泡"/></DockPanel>
                    <Slider x:Name="BubbleSizeSlider" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding BubbleSizePercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="文字气泡大小"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="图层不透明度" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="3" Margin="0,12,0,0">
                <StackPanel Margin="0,0,14,0">
                    <DockPanel><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding TextOpacityPercent, StringFormat={}{0}%}"/><TextBlock Text="文字"/></DockPanel>
                    <Slider x:Name="TextSlider" AutomationProperties.Name="文字不透明度" Minimum="0" Maximum="100" Value="{Binding TextOpacityPercent, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <DockPanel><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding AvatarOpacityPercent, StringFormat={}{0}%}"/><TextBlock Text="形象"/></DockPanel>
                    <Slider x:Name="AvatarSlider" AutomationProperties.Name="形象不透明度" Minimum="0" Maximum="100" Value="{Binding AvatarOpacityPercent, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,14,0">
                    <DockPanel><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding BackdropOpacityPercent, StringFormat={}{0}%}"/><TextBlock Text="背景"/></DockPanel>
                    <Slider x:Name="BackdropSlider" AutomationProperties.Name="背景不透明度" Minimum="0" Maximum="100" Value="{Binding BackdropOpacityPercent, UpdateSourceTrigger=PropertyChanged}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
