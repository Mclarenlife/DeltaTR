<UserControl x:Class="DeltaTR.App.Views.RadioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="TEAM RADIO / 01" FontFamily="Segoe UI" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="中文 · 本地通道" Foreground="#8599AB" HorizontalAlignment="Right" FontSize="11"/></Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,12"><StackPanel>
                <TextBlock Text="车手" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding LastQuestion}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,12"/>
                <Border Background="#1B2E2A" BorderBrush="#315044" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="{Binding RadioAnswerLabel}" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock Text="{Binding Answer}" TextWrapping="Wrap" LineHeight="27" FontSize="17" Margin="0,10,0,0"/></StackPanel></Border>
                <StackPanel Visibility="{Binding HasRaceAlert, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                    <TextBlock Text="最近赛事提醒" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding LastRaceAlert}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="2" Background="#111A24" CornerRadius="8" Padding="14" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#ADC7BA" FontSize="12" Margin="0,0,0,8"/>
                <ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Maximum="100" Height="4" Background="#253A36" Foreground="#9AE6BD" BorderThickness="0" Margin="0,0,0,10" AutomationProperties.Name="麦克风输入音量"/>
                <Button x:Name="TalkButton" Content="{Binding TalkLabel}" Style="{StaticResource PrimaryAction}" FontSize="16" Padding="20,12" IsEnabled="{Binding CanTalk}" PreviewMouseLeftButtonDown="StartTalk" PreviewMouseLeftButtonUp="EndTalk" LostMouseCapture="LostTalkCapture" AutomationProperties.Name="{Binding TalkHint}"/>
                <Grid Margin="0,8,0,0"><TextBlock Text="松开发送 · 最长 15 秒" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/><Button Content="停止播报" Command="{Binding SilenceCommand}" Style="{StaticResource Action}" Padding="10,4" HorizontalAlignment="Right"/></Grid>
            </StackPanel></Border>
            <StackPanel Grid.Row="3"><TextBlock Text="也可以输入问题" Style="{StaticResource Eyebrow}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="无线电文本问题"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding QueryCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="发送" Style="{StaticResource Action}" Command="{Binding QueryCommand}" Margin="8,0,0,0"/></Grid></StackPanel>
        </Grid></Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前驾驶会话" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Track}" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{Binding Car}" Style="{StaticResource Hint}"/><Border Background="#1B2E2A" CornerRadius="4" Padding="10,4" HorizontalAlignment="Left" Margin="0,16,0,0"><TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource Accent}" FontSize="11"/></Border></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="试着呼叫工程师" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ExampleQuestions}" LineHeight="32" Foreground="#ADBCCE" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="AI 工程师" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding WakeHint}" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="普通车况问题由本地遥测直接回答。" Style="{StaticResource Hint}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
    </Grid>
</UserControl>
