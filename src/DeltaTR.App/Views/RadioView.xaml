<UserControl x:Class="DeltaTR.App.Views.RadioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="中文通话" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                    <TextBlock Text="当前通话" Style="{StaticResource SectionTitle}"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,16">
                    <StackPanel>
                        <TextBlock Text="车手" Style="{StaticResource Eyebrow}"/>
                        <TextBlock Text="{Binding LastQuestion}" TextWrapping="Wrap" Margin="0,4,0,24" FontSize="15"/>
                        <Border BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="16,0,4,4">
                            <StackPanel>
                                <TextBlock Text="工程师" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" FontSize="21" LineHeight="34" Margin="0,8"/>
                                <TextBlock Text="{Binding RadioAnswerLabel}" Style="{StaticResource Eyebrow}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Visibility="{Binding HasRaceAlert, Converter={StaticResource BoolVisibility}}" Margin="0,24,0,0">
                            <TextBlock Text="最近赛事提醒" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="{Binding LastRaceAlert}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="0,16,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="TalkButton" Content="{Binding TalkLabel}" Style="{StaticResource PrimaryAction}" FontSize="14" Padding="16,12"
                                IsEnabled="{Binding CanTalk}" PreviewMouseLeftButtonDown="StartTalk" PreviewMouseLeftButtonUp="EndTalk" LostMouseCapture="LostTalkCapture"
                                ToolTip="{Binding TalkHint}" AutomationProperties.Name="{Binding TalkHint}"/>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VoiceStatus}" Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VoiceStatus}"/>
                            <ProgressBar Value="{Binding AudioLevel, Mode=OneWay}" Maximum="100" Height="4" Background="{DynamicResource TrackBrush}"
                                         Foreground="{DynamicResource Accent}" BorderThickness="0" Margin="0,8,0,0" AutomationProperties.Name="麦克风输入音量"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="停止播报" Command="{Binding SilenceCommand}" Style="{StaticResource Action}" VerticalAlignment="Center" Padding="10,6"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="松开发送 · 最长 15 秒" Style="{StaticResource Eyebrow}" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="文字提问" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="无线电文本问题">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding QueryCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="发送" Command="{Binding QueryCommand}" Style="{StaticResource Action}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,8,8,0">
                <TextBlock Text="驾驶会话" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding Track}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding Car}" Style="{StaticResource Hint}"/>
                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Eyebrow}" Margin="0,4,0,0"/>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rule}" Padding="0,16,0,0" Margin="0,24,0,0">
                    <StackPanel><TextBlock Text="常用问法" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ExampleQuestions}" LineHeight="28" Foreground="{DynamicResource Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Rule}" Padding="0,16,0,0" Margin="0,20,0,0">
                    <StackPanel><TextBlock Text="呼叫 AI 工程师" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding WakeHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                        <TextBlock Text="普通车况问题由本地遥测直接回答" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
